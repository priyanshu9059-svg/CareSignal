# Leave DATABASE_URL unset for local SQLite. Docker overrides it with PostgreSQL.
# DATABASE_URL=postgresql+psycopg://caresignal:YOUR_PASSWORD@localhost:5432/caresignal
# Required for PostgreSQL / production. Optional for local SQLite (ephemeral key per process).
JWT_SECRET=
POSTGRES_PASSWORD=
AI_MODE=demo
DEMO_ENABLED=true
COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3000
# MODEL_PATH defaults to ai/models; use an absolute path when overriding.
STORAGE_PATH=storage
NEXT_TELEMETRY_DISABLED=1
# Optional JSON overrides: RISK_WEIGHTS and RISK_THRESHOLDS; see backend/app/config.py.
# SMS/email/OpenAI providers are not wired in this prototype (integrations are mock-only).
