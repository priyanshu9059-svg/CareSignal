# Leave DATABASE_URL unset for local SQLite. Docker overrides it with PostgreSQL.
# DATABASE_URL=postgresql+psycopg://caresignal:YOUR_PASSWORD@localhost:5432/caresignal
# Required for PostgreSQL / production. Optional for local SQLite (ephemeral key per process).
JWT_SECRET=
POSTGRES_PASSWORD=
AI_MODE=demo
DEMO_ENABLED=true
COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3000
# Comma-separated extra allowed mutation origins (custom domains / previews).
# APP_ORIGINS=https://app.example.com,https://www.example.com
# MODEL_PATH defaults to ai/models; use an absolute path when overriding.
STORAGE_PATH=storage
NEXT_TELEMETRY_DISABLED=1
# Outreach (soft-fail; in-app notify always works)
# SMS_PROVIDER=mock|log|webhook
# EMAIL_PROVIDER=mock|log|smtp|webhook
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASSWORD= SMTP_FROM= SMTP_TLS=true
# OUTREACH_WEBHOOK_URL=
# STAFF_ALERT_SMS_TO=
# ASR_PROVIDER=none|auto|openai|local
# OPENAI_API_KEY=
# WHISPER_MODEL=base
